# Copy this file to ".env.local" and fill in the values.
# Every key is optional: anything left blank switches that part of the app
# into "demo mode" so you can still click around.

# --- Claude (chat assistant) ------------------------------------------------
# Get a key at https://console.anthropic.com  ->  API Keys
# This key is only used on the server. Never put it in a NEXT_PUBLIC_ variable.
ANTHROPIC_API_KEY=
# Optional. Haiku is cheaper/faster for a hackathon; Sonnet gives better answers.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Maps (results map) ----------------------------------------------
# Google Cloud Console -> APIs & Services -> enable "Maps JavaScript API"
# -> Credentials -> Create API key. Restrict it to your website address.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional. "DEMO_MAP_ID" works for testing; create your own Map ID for production.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Supabase (accounts, database, file storage) ----------------------------
# supabase.com -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Use the "publishable" key (older projects call it the "anon" key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address your site runs on (used in sign-up confirmation emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
