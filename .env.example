# Copy this file to ".env.local" and fill in the values.
# Every key is optional: anything left blank switches that part of the app
# into "demo mode" so you can still click around.

# --- Claude (chat assistant) ------------------------------------------------
# Get a key at https://console.anthropic.com  ->  API Keys
# This key is only used on the server. Never put it in a NEXT_PUBLIC_ variable.
ANTHROPIC_API_KEY=
# Optional. Haiku is cheaper/faster for a hackathon; Sonnet gives better answers.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Maps (results map) ----------------------------------------------
# Google Cloud Console -> APIs & Services -> enable "Maps JavaScript API"
# -> Credentials -> Create API key. Restrict it to your website address.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional. "DEMO_MAP_ID" works for testing; create your own Map ID for production.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Supabase (accounts, database, file storage) ----------------------------
# supabase.com -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Use the "publishable" key (older projects call it the "anon" key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address your site runs on (used in sign-up confirmation emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Tavily discovery (optional; no keys are exposed to the browser)
TAVILY_API_KEY=
TAVILY_MAX_CREDITS=14
TAVILY_MAX_RESULTS=5
TAVILY_MAX_REQUESTS=13
TAVILY_MIN_INTERVAL_MS=300
TAVILY_MAX_EXTRACT_PAGES=5
TAVILY_DOMAINS=zalando.de,primark.com,adaptawear.com

# Optional server-only product source credentials; never expose these to the browser.
AWIN_PUBLISHER_ID=
AWIN_ADVERTISER_ID=
AWIN_API_TOKEN=
AWIN_FEED_LOCALE=de_DE
AWIN_SHIP_TO_COUNTRY=DE
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ACCESS_TOKEN=
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE=EBAY_DE
EBAY_PRODUCTION_APPROVED=false
